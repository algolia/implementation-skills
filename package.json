{
  "name": "algolia-skills-library",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "sync:source": "node scripts/sync-source.mjs",
    "package:downloads": "node scripts/package-downloads.mjs",
    "validate:skills": "node algolia-implementation-skills-repo/scripts/validate-skills.mjs",
    "validate:packages": "node scripts/validate-packages.mjs",
    "release:prepare": "npm run sync:source && npm run package:downloads && npm run validate:skills && npm run validate:packages && npm run build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "devDependencies": {
    "playwright": "^1.61.1"
  }
}
